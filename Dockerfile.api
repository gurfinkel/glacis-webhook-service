FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Install deps without our project (better layer caching).
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY project/ project/
COPY webhooks/ webhooks/
COPY workflows/ workflows/
COPY manage.py ./

FROM python:3.12-slim

# Non-root user — never run web/worker processes as root in containers.
RUN groupadd --system app && useradd --system --gid app --uid 1000 app

WORKDIR /app

COPY --from=builder --chown=app:app /app /app
ENV PATH="/app/.venv/bin:$PATH"
ENV DJANGO_SETTINGS_MODULE="project.settings.prod"

USER app
EXPOSE 8000

CMD ["gunicorn", "project.wsgi:application", "-c", "project/gunicorn_conf.py"]
