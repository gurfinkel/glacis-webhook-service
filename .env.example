# Django bootstrap
DEBUG=False
DJANGO_SECRET_KEY=replace-me-with-a-random-50-char-string
ALLOWED_HOSTS=example.com,api.example.com

# LLM (OpenRouter). Required in prod.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Datastores
POSTGRES_URL=postgres://postgres:postgres@postgres:5432/glacis
REDIS_URL=redis://redis:6379/0

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=webhook-classification
TEMPORAL_START_WORKFLOW_TIMEOUT=5.0

# Backpressure cap on the sync→async bridge: max sync callers blocked
# at once. When exceeded, the view 503s with Retry-After=1 instead of
# blocking gthread threads on the 5s submit timeout — keeps the worker
# pool free during a Temporal frontend slowdown. Default = 64
# (generous vs 4×8 gthread); raise if you scale workers/threads.
TEMPORAL_BRIDGE_MAX_INFLIGHT=64

# LLM retry budget
MAX_RETRIES=3

# Sweeper Schedule (Temporal-managed). Re-issues start_workflow for events
# stuck at RECEIVED (start_workflow never landed) past SWEEPER_GRACE_SECONDS,
# or stuck at PROCESSING (workflow ran but died — most often run-timeout
# during a long LLM retry loop) past SWEEPER_PROCESSING_GRACE_SECONDS.
#
# SWEEPER_PROCESSING_GRACE_SECONDS MUST exceed WORKFLOW_RUN_TIMEOUT (10 min,
# in workflows/definitions.py) plus a 5 min safety buffer, or the sweeper
# races live workflows. Worker bootstrap raises ValueError on violation.
SWEEPER_INTERVAL_SECONDS=60
SWEEPER_GRACE_SECONDS=300
SWEEPER_PROCESSING_GRACE_SECONDS=900
SWEEPER_BATCH_LIMIT=100

# Per-vendor rate limiting (django-ratelimit syntax: COUNT/DURATION).
# DEFAULT_RATE_LIMIT runs *after* HMAC verify; bucket key = vendor_id.
# PRE_AUTH_IP_RATE_LIMIT runs *before* HMAC verify (middleware) so a
# flood of forged signatures from one IP gets 429'd without paying the
# auth-chain cost (sha256 + DB lookup per request). Set higher than
# the per-vendor limit because multiple vendors may share an IP.
DEFAULT_RATE_LIMIT=100/10s
PRE_AUTH_IP_RATE_LIMIT=200/10s

# Observability — point at any OTLP-compatible collector (Tempo, Jaeger, Honeycomb).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=glacis-webhook-service
